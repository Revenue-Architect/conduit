    },
    "TaskCard": {
      "$ref": "#/$defs/TaskCard"
    },
    "KanbanColumn": {
      "$ref": "#/$defs/KanbanColumn"
    },
    "Kanban": {
      "$ref": "#/$defs/Kanban"
    },
    "Scorecard": {
      "$ref": "#/$defs/Scorecard"
    },
    "Price": {
      "$ref": "#/$defs/Price"
    },
    "ContactCard": {
      "$ref": "#/$defs/ContactCard"
    },
    "FileCard": {
      "$ref": "#/$defs/FileCard"
    },
    "Breadcrumbs": {
      "$ref": "#/$defs/Breadcrumbs"
    },
    "Status": {
      "$ref": "#/$defs/Status"
    },
    "DefinitionList": {
      "$ref": "#/$defs/DefinitionList"
    }
  },
  "required": [
    "Stack",
    "Grid",
    "Card",
    "Text",
    "Metric",
    "Badge",
    "Button",
    "Input",
    "Select",
    "Checkbox",
    "Form",
    "Table",
    "BarChart",
    "Progress",
    "Row",
    "Section",
    "Divider",
    "Heading",
    "CodeBlock",
    "Quote",
    "Callout",
    "KeyValue",
    "List",
    "NumberedList",
    "Checklist",
    "TimelineItem",
    "Timeline",
    "Step",
    "Steps",
    "Details",
    "AccordionItem",
    "Accordion",
    "Tab",
    "Tabs",
    "Carousel",
    "TagGroup",
    "Avatar",
    "EmptyState",
    "Notification",
    "TextArea",
    "NumberInput",
    "DatePicker",
    "TimePicker",
    "Slider",
    "Switch",
    "RadioGroup",
    "MultiSelect",
    "Rating",
    "LineChart",
    "AreaChart",
    "PieChart",
    "DonutChart",
    "Sparkline",
    "Gauge",
    "Heatmap",
    "Comparison",
    "Citation",
    "DraftReview",
    "AgendaItem",
    "Agenda",
    "TaskCard",
    "KanbanColumn",
    "Kanban",
    "Scorecard",
    "Price",
    "ContactCard",
    "FileCard",
    "Breadcrumbs",
    "Status",
    "DefinitionList"
  ],
  "additionalProperties": false,
  "$defs": {
    "Stack": {
      "type": "object",
      "properties": {
        "children": {
          "maxItems": 48,
          "type": "array",
          "items": {}
        }
      },
      "required": [
        "children"
      ],
      "additionalProperties": false,
      "id": "Stack",
      "description": "Required root; vertical layout."
    },
    "Grid": {
      "type": "object",
      "properties": {
        "children": {
          "maxItems": 48,
          "type": "array",
          "items": {}
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      },
      "required": [
        "children"
      ],
      "additionalProperties": false,
      "id": "Grid",
      "description": "Responsive cards or metrics; wraps on small windows."
    },
    "Card": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "maxLength": 160
        },
        "children": {
          "maxItems": 48,
          "type": "array",
          "items": {}
        }
      },
      "required": [
        "title",
        "description",
        "children"
      ],
      "additionalProperties": false,
      "id": "Card",
      "description": "Panel with heading, subtitle and children."
    },
    "Text": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 4000
        },
        "tone": {
          "type": "string",
          "enum": [
            "neutral",
            "accent",
            "success",
            "warning"
          ]
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "id": "Text",
      "description": "Plain text; never HTML or Markdown."
    },
    "Metric": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 160
        },
        "value": {
          "type": "string",
          "maxLength": 160
        },
        "caption": {
          "type": "string",
          "maxLength": 160
        }
      },
      "required": [
        "label",
        "value",
        "caption"
      ],
      "additionalProperties": false,
      "id": "Metric",
      "description": "Large value with label and supporting detail; supplied or computed data only."
    },
    "Badge": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 160
        },
        "tone": {
          "type": "string",
          "enum": [
            "neutral",
            "accent",
            "success",
            "warning"
          ]
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false,
      "id": "Badge",
      "description": "Short status with label, never colour alone."
    },
    "Button": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 160
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "variant": {
          "type": "string",
          "enum": [
            "primary",
            "secondary"
          ]
        }
      },
      "required": [
        "label",
        "message"
      ],
      "additionalProperties": false,
      "id": "Button",
      "description": "Explicit conversational request. Sends message plus this form's current fields to the originating Hermes session; never invokes a tool or sends a draft."
    },
    "Input": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,47}$"
        },
        "label": {
          "type": "string",
          "maxLength": 160
        },
        "placeholder": {
          "type": "string",
          "maxLength": 160
        },
        "initial": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "name",
        "label",
        "placeholder",
        "initial"
      ],
      "additionalProperties": false,
      "id": "Input",
      "description": "Local text field inside Form; values sent only when Button is clicked."
    },
    "Select": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,47}$"
        },
        "label": {
          "type": "string",
          "maxLength": 160
        },
        "options": {
          "minItems": 1,
          "maxItems": 24,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 160
          }
        },
        "initial": {
          "type": "string",
          "maxLength": 160
        }
      },
      "required": [
        "name",
        "label",
        "options",
        "initial"
      ],
      "additionalProperties": false,
      "id": "Select",
      "description": "Local select inside Form. Initial must be one of the options."
    },
    "Checkbox": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,47}$"
        },
        "label": {
          "type": "string",
          "maxLength": 160
        },
        "initial": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "label",
        "initial"
      ],
      "additionalProperties": false,
      "id": "Checkbox",
      "description": "Local checkbox inside Form."
    },
    "Form": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,47}$"
        },
        "children": {
          "maxItems": 48,
          "type": "array",
          "items": {}
        }
      },
      "required": [
        "name",
        "children"
      ],
      "additionalProperties": false,
      "id": "Form",
      "description": "Collect form fields for its explicit Button. Never nest forms. At most 16 fields."
    },
    "Table": {
      "type": "object",
      "properties": {
        "columns": {
          "minItems": 1,
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 160
          }
        },
        "rows": {
          "maxItems": 60,
          "type": "array",
          "items": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 800
            }
          }
        }
      },
      "required": [
        "columns",
        "rows"
      ],
      "additionalProperties": false,
      "id": "Table",
      "description": "Bounded table. Every row has exactly one plain text cell per column. Scrolls horizontally."
    },
    "BarChart": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "labels": {
          "minItems": 1,
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 160
          }
        },
        "values": {
          "minItems": 1,
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000000
          }
        },
        "unit": {
          "type": "string",
          "maxLength": 24
        }
      },
      "required": [
        "title",
        "labels",
        "values",
        "unit"
      ],
      "additionalProperties": false,
      "id": "BarChart",
      "description": "Horizontal bars for aligned nonnegative values. Actual values remain visible."
    },
    "Progress": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 160
        },
        "value": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "label",
        "value",
        "max"
      ],
      "additionalProperties": false,
      "id": "Progress",
      "description": "Progress toward a supplied positive maximum."
    },
    "Row": {
      "type": "object",
      "properties": {
        "children": {
          "maxItems": 48,
          "type": "array",
          "items": {}
        }
      },
      "required": [
        "children"
      ],
      "additionalProperties": false,
      "id": "Row",
      "description": "Wrapping horizontal group."
    },
    "Section": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "children": {
          "maxItems": 48,
          "type": "array",
          "items": {}
        }
      },
      "required": [
        "title",
        "children"
      ],
      "additionalProperties": false,
      "id": "Section",
      "description": "Heading and vertically stacked content."
    },
    "Divider": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 160
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false,
      "id": "Divider",
      "description": "Quiet divider with optional label."
    },
    "Heading": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "subtitle": {
          "type": "string",
          "maxLength": 160
        }
      },
      "required": [
        "title",
        "subtitle"
      ],
      "additionalProperties": false,
      "id": "Heading",
      "description": "Section heading with optional description."
    },
    "CodeBlock": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string",
          "maxLength": 160
        },
        "code": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "language",
        "code"
      ],
      "additionalProperties": false,
      "id": "CodeBlock",
      "description": "Read-only code with language label. Never executes."
    },
    "Quote": {
      "type": "object",
      "properties": {
        "quote": {
          "type": "string",
          "maxLength": 4000
        },
        "source": {
          "type": "string",
          "maxLength": 160
        }
      },
      "required": [
        "quote",
        "source"
      ],
      "additionalProperties": false,
      "id": "Quote",
      "description": "Exact quotation and supplied attribution."
    },
    "Callout": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "message": {
          "type": "string",
          "maxLength": 4000
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "success",
            "warning",
            "error"
          ]
        }
      },
      "required": [
        "title",
        "message",
        "severity"
      ],
      "additionalProperties": false,
      "id": "Callout",
      "description": "Labelled info, success, warning or error. Use supplied facts."
    },
    "KeyValue": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 160
        },
        "value": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "label",
        "value"
      ],
      "additionalProperties": false,
      "id": "KeyValue",
      "description": "A label/value row."
    },
    "List": {
      "type": "object",
      "properties": {
        "items": {
          "maxItems": 48,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false,
      "id": "List",
      "description": "Plain bullet list."
    },
    "NumberedList": {
      "type": "object",
      "properties": {
        "items": {
          "maxItems": 48,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false,
      "id": "NumberedList",
      "description": "Ordered plain text steps."
    },
    "Checklist": {
      "type": "object",
      "properties": {
        "items": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 160
          }
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false,
      "id": "Checklist",
      "description": "Local checklist; checking does not send a request or change operational state."
    },
    "TimelineItem": {
      "type": "object",
      "properties": {
        "time": {
          "type": "string",
          "maxLength": 160
        },
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "detail": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "time",
        "title",
        "detail"
      ],
      "additionalProperties": false,
      "id": "TimelineItem",
      "description": "A supplied timeline event; time is text, not an inferred deadline."
    },
    "Timeline": {
      "type": "object",
      "properties": {
        "children": {
          "maxItems": 48,
          "type": "array",
          "items": {}
        }
      },
      "required": [
        "children"
      ],
      "additionalProperties": false,
      "id": "Timeline",
      "description": "Vertical TimelineItem children only."
    },
    "Step": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "detail": {
          "type": "string",
          "maxLength": 4000
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "current",
            "done"
          ]
        }
      },
      "required": [
        "title",
        "detail",
        "status"
      ],
      "additionalProperties": false,
      "id": "Step",
      "description": "A process step with explicit status."
    },
    "Steps": {
      "type": "object",
      "properties": {
        "children": {
          "maxItems": 48,
          "type": "array",
          "items": {}
        }
      },
      "required": [
        "children"
      ],
      "additionalProperties": false,
      "id": "Steps",
      "description": "Process made of Step children only."
    },
    "Details": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "children": {
          "maxItems": 48,
          "type": "array",
          "items": {}
        },
        "open": {
          "type": "boolean"
        }
      },
      "required": [
        "title",
        "children"
      ],
      "additionalProperties": false,
      "id": "Details",
      "description": "Local disclosure. Expands without sending a request."
    },
    "AccordionItem": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "children": {
          "maxItems": 48,
          "type": "array",
          "items": {}
        }
      },
      "required": [
        "title",
        "children"
      ],
      "additionalProperties": false,
      "id": "AccordionItem",
      "description": "A locally expandable accordion section."
    },
    "Accordion": {
      "type": "object",
      "properties": {
        "children": {
          "maxItems": 48,
          "type": "array",
          "items": {}
        }
      },
      "required": [
        "children"
      ],
      "additionalProperties": false,
      "id": "Accordion",
      "description": "Expandable AccordionItem children only."
    },
    "Tab": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "children": {
          "maxItems": 48,
          "type": "array",
          "items": {}
        }
      },
      "required": [
        "title",
        "children"
      ],
      "additionalProperties": false,
      "id": "Tab",
      "description": "Named page inside Tabs."
    },
    "Tabs": {
      "type": "object",
      "properties": {
        "children": {
          "maxItems": 48,
          "type": "array",
          "items": {}
        }
      },
      "required": [
        "children"
      ],
      "additionalProperties": false,
      "id": "Tabs",
      "description": "Local tab navigation; only Tab children. Hidden pages remain mounted so form edits survive tab switching."
    },
    "Carousel": {
      "type": "object",
