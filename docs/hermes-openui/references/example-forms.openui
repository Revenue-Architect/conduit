root = Stack([Heading("Make a choice", "Edits stay local; only the explicit button sends to Hermes"), Form("preferences", [Grid([Input("name", "Name", "Example name", "Alex"), Select("activity", "Activity", ["Reading", "Museum"], "Reading"), NumberInput("budget", "Budget", 0, 100, 20), DatePicker("date", "Date", "2026-10-17"), TimePicker("time", "Time", "10:00"), Slider("duration", "Duration", 1, 8, 2)], 2), TextArea("notes", "Notes", "What matters to you?", "Keep it relaxed."), Row([Checkbox("outdoors", "Prefer outdoors", false), Switch("quiet", "Quiet places", true)]), RadioGroup("pace", "Pace", ["Relaxed", "Busy"], "Relaxed"), MultiSelect("interests", "Interests", ["Art", "Books", "Food"], ["Books"]), Rating("rating", "Excitement", 4), Button("Plan this in chat", "Use these form values to suggest an example weekend plan. Do not book, send or schedule anything.")])])
