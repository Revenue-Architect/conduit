+/// The only REST routes [HermesDesktopAdminRequests.requestAdminJson] will
+/// call, each with the methods allowed on it. Everything the admin client
+/// needs is here; anything else (`/api/shell`, `/api/env/reveal`, a typo'd
+/// path) is refused before a request is built (KTD6, KTD8).
+///
+/// Names in a path are percent-encoded segments. `..` and encoded dots or
+/// slashes are rejected separately, so a segment can never climb out.
+final List<({Set<String> methods, RegExp path})> _hermesAdminRoutes = [
+  (
+    methods: {'DELETE'},
+    path: RegExp(r'^/api/profiles/[a-z0-9][a-z0-9_-]{0,63}$'),
+  ),
+  (
+    methods: {'GET', 'PUT'},
+    path: RegExp(r'^/api/profiles/[a-z0-9][a-z0-9_-]{0,63}/soul$'),
+  ),
+  // Never `/api/env/reveal`: keys are write-only (KTD8).
+  (methods: {'GET', 'PUT', 'DELETE'}, path: RegExp(r'^/api/env$')),
+  (methods: {'GET'}, path: RegExp(r'^/api/providers/oauth$')),
+  (
+    methods: {'POST'},
+    path: RegExp(r'^/api/providers/oauth/[A-Za-z0-9_.~%-]{1,128}/start$'),
+  ),
+  (
+    methods: {'GET'},
+    path: RegExp(
+      r'^/api/providers/oauth/[A-Za-z0-9_.~%-]{1,128}/poll/[A-Za-z0-9_.~%-]{1,256}$',
+    ),
+  ),
+  (
+    methods: {'DELETE'},
+    path: RegExp(r'^/api/providers/oauth/sessions/[A-Za-z0-9_.~%-]{1,256}$'),
+  ),
+  (
+    methods: {'DELETE'},
+    path: RegExp(r'^/api/providers/oauth/[A-Za-z0-9_.~%-]{1,128}$'),
+  ),
+  (methods: {'POST'}, path: RegExp(r'^/api/providers/validate$')),
+  (methods: {'POST'}, path: RegExp(r'^/api/model/set$')),
+  (methods: {'GET', 'PUT'}, path: RegExp(r'^/api/config$')),
+  (methods: {'GET', 'PUT'}, path: RegExp(r'^/api/config/raw$')),
+  (methods: {'GET'}, path: RegExp(r'^/api/config/(schema|defaults)$')),
+  (methods: {'GET'}, path: RegExp(r'^/api/tools/toolsets$')),
+  (
+    methods: {'PUT'},
+    path: RegExp(r'^/api/tools/toolsets/[A-Za-z0-9_.~%-]{1,128}$'),
+  ),
+  (methods: {'PUT'}, path: RegExp(r'^/api/skills/toggle$')),
+  (
+    methods: {'PUT'},
+    path: RegExp(r'^/api/mcp/servers/[A-Za-z0-9_.~%-]{1,256}/enabled$'),
+  ),
+  (methods: {'GET', 'PUT', 'DELETE'}, path: RegExp(r'^/api/learning/node$')),
+  (methods: {'POST'}, path: RegExp(r'^/api/gateway/restart$')),
+];
+
+final RegExp _hermesAdminPathEscape = RegExp(
+  r'%2e|%2f|%5c|\.\.|[\\?#\s]',
+  caseSensitive: false,
+);
+
+/// Whether the admin client may send [method] to [path]. Pure, so the
+/// allowlist can be tested without a connection.
+bool hermesAdminRouteAllowed(String method, String path) {
+  if (_hermesAdminPathEscape.hasMatch(path)) return false;
+  final upper = method.toUpperCase();
+  return _hermesAdminRoutes.any(
+    (route) => route.methods.contains(upper) && route.path.hasMatch(path),
+  );
+}
+
+/// MCP gateway methods [HermesDesktopAdminRequests.requestAdminMcp] forwards.
+const Set<String> _hermesAdminMcpMethods = {
+  'mcp.catalog',
+  'mcp.servers.list',
+  'mcp.servers.status',
+  'mcp.servers.add',
+  'mcp.servers.set_api_key',
+  'mcp.servers.test',
+  'mcp.servers.remove',
+  'mcp.servers.oauth.start',
+  'mcp.servers.oauth.poll',
+  'mcp.servers.oauth.cancel',
+};
+
+/// The Hermes admin client's way into this service (KTD6): REST through the
+/// service's own auth path (native bearer with refresh, or the dashboard
+/// cookie bridge), and the existing MCP wrapper with a profile.
+///
+/// It never reaches `cli.exec` or `shell.exec`, and the REST side accepts only
+/// [hermesAdminRouteAllowed] routes.
+extension HermesDesktopAdminRequests on HermesDesktopApiService {
+  /// Opens the Desktop Gateway if it is not open yet.
+  Future<void> ensureAdminConnected() => _ensureConnected();
+
+  /// A JSON request to an allowlisted admin route. Error bodies are kept on
+  /// the [DioException] so the client can tell a missing route from a missing
+  /// profile. Every call names its profile in [query] (or [body] where Hermes
+  /// reads it there); nothing here adds one.
+  Future<Object?> requestAdminJson(
+    String method,
+    String path, {
+    Map<String, dynamic>? query,
+    Map<String, Object?>? body,
+    CancelToken? cancelToken,
+  }) async {
+    if (_closed) throw StateError('Hermes service is closed.');
+    if (!hermesAdminRouteAllowed(method, path)) {
+      throw StateError('Invalid Hermes admin request.');
+    }
+    return _requestJson(
+      method.toUpperCase(),
+      path,
+      query: query,
+      body: body,
+      cancelToken: cancelToken,
+      receiveErrorBody: true,
+    );
+  }
+
+  /// An `mcp.*` gateway call that carries `profile` in [params], with the
+  /// REST fallback the MCP page already uses when the gateway predates the
+  /// method. Does not reload MCP; the admin client does that on request.
+  Future<Map<String, dynamic>> requestAdminMcp(
+    String method, {
+    Map<String, dynamic> params = const {},
+  }) async {
+    if (!_hermesAdminMcpMethods.contains(method)) {
+      throw StateError('Invalid Hermes admin MCP request.');
+    }
+    try {
+      return await _administration.mcpRequest(method, params: params);
+    } on StateError catch (error) {
+      // The fallback has no REST twin for this method: report it as the
+      // unknown-method error the client already treats as "unavailable".
+      if (error.message.startsWith('Upgrade Hermes Desktop Gateway')) {
+        throw HermesDesktopRpcException(error.message, code: -32601);
+      }
+      rethrow;
+    }
+  }
+}
