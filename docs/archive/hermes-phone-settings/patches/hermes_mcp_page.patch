+/// Where Hermes' "reload MCP?" question, or the reload under way, shows on a
+/// bot's MCP page.
+class _ReloadBanner extends StatelessWidget {
+  const _ReloadBanner({
+    required this.message,
+    required this.onReload,
+    required this.onLater,
+  });
+
+  /// Hermes' own wording; null while a reload is running.
+  final String? message;
+  final VoidCallback? onReload;
+  final VoidCallback? onLater;
+
+  @override
+  Widget build(BuildContext context) {
+    final scheme = Theme.of(context).colorScheme;
+    final asking = message != null;
+    return Semantics(
+      container: true,
+      liveRegion: true,
+      child: Container(
+        key: const ValueKey('mcp-reload-banner'),
+        margin: const EdgeInsets.fromLTRB(16, 8, 16, 4),
+        padding: const EdgeInsets.fromLTRB(14, 10, 10, 8),
+        decoration: BoxDecoration(
+          borderRadius: BorderRadius.circular(14),
+          border: Border.all(color: scheme.outlineVariant),
+        ),
+        child: asking
+            ? Column(
+                crossAxisAlignment: CrossAxisAlignment.stretch,
+                children: [
+                  Text(
+                    'Reload MCP to apply this? ${message!} '
+                    'It applies to every running chat, not only this bot.',
+                  ),
+                  OverflowBar(
+                    alignment: MainAxisAlignment.end,
+                    spacing: 8,
+                    children: [
+                      TextButton(
+                        onPressed: onLater,
+                        child: const Text('Later'),
+                      ),
+                      FilledButton(
+                        onPressed: onReload,
+                        child: const Text('Reload'),
+                      ),
+                    ],
+                  ),
+                ],
+              )
+            : const Row(
+                children: [
+                  SizedBox(
+                    width: 16,
+                    height: 16,
+                    child: CircularProgressIndicator(strokeWidth: 2),
+                  ),
+                  SizedBox(width: 10),
+                  Text('Reloading MCP…'),
+                ],
+              ),
+      ),
+    );
+  }
+}
