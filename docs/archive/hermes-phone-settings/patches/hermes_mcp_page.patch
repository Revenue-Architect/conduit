+  /// A bot's MCP sign-in: open the provider's page, then wait for Hermes to
+  /// say it is done (up to two minutes).
+  Future<bool> _signInScoped(String profile, String name) async {
+    final client = _admin;
+    final started = await client.startMcpOAuth(profile, name);
+    final url = parseAllowedExternalLink(started.authUrl);
+    if (url == null ||
+        !const {'http', 'https'}.contains(url.scheme) ||
+        !await launchUrl(url, mode: LaunchMode.externalApplication)) {
+      await client.cancelMcpOAuth(profile, name, started.sessionId);
+      return false;
+    }
+    for (var attempt = 0; attempt < 60; attempt++) {
+      await Future<void>.delayed(const Duration(seconds: 2));
+      if (!mounted) break;
+      final poll = await client.pollMcpOAuth(profile, name, started.sessionId);
+      switch (poll.state) {
+        case HermesAdminSignInState.approved:
+          return true;
+        case HermesAdminSignInState.failed:
+        case HermesAdminSignInState.expired:
+          return false;
+        case HermesAdminSignInState.pending:
+          break;
+      }
+    }
+    await client.cancelMcpOAuth(profile, name, started.sessionId);
+    return false;
+  }
