+  /// Desktop boot policy (U1, R1). Returns where desktop must go instead of
+  /// [location], or null to let the shared Hermes-only policy decide, which
+  /// already sends a usable Hermes from splash to Hermez home.
+  ///
+  /// - Hermes settings always renders: it is the desktop's setup surface.
+  /// - With Hermes not set up, every other location opens Hermes onboarding.
+  /// - The backend chooser, every Open WebUI auth route and every Open
+  ///   WebUI-only page open Hermez home, or Hermes setup while it is unusable.
+  /// - Phone-only pages (audio settings: dictation and spoken replies, U2, R3)
+  ///   redirect the same way, so a stale deep link never lands on them.
+  String? _desktopRedirect(String location) {
+    if (location == Routes.hermesSettings) return null;
+    final hermesConfig = ref.read(hermesConfigProvider);
+    final String destination;
+    if (!hermesConfig.enabled) {
+      destination = _hermesOnboardingLocation;
+    } else if (!_isDesktopOpenWebUiLocation(location)) {
+      return null;
+    } else if (hermesConfig.isUsable) {
+      destination = Routes.hermesHome;
+    } else {
+      destination = incompleteHermesDestination(
+        secretsLoading: ref.read(hermesSecretsLoadingProvider),
+      );
+    }
+    return Uri.parse(destination).path == location ? null : destination;
+  }
