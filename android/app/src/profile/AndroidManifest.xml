<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug/profile only: lets adb feed a plaintext push envelope to the same
             intake path (see DebugPushReceiver). android.permission.DUMP is held by the
             adb shell but by no ordinary app, so other apps cannot broadcast to it. -->
        <receiver
            android:name="app.cogwheel.conduit.push.DebugPushReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
</manifest>
